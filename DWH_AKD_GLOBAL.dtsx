                  name="DefaultCodePage">1254</property>
              </properties>
              <connections>
                <connection
                  refId="Package\SLOWLY CHANGING\CARI HESAPLAR SCD.Connections[LookupConnection]"
                  connectionManagerID="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}:external"
                  connectionManagerRefId="Project.ConnectionManagers[LocalHost.DWH_AKD_GLOBAL]"
                  description="Defines the connection to use for lookups in the dimension table"
                  name="LookupConnection" />
              </connections>
