    <DTS:Executable
      DTS:refId="Package\SATIS_ANALIZ_CARI_PER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9AA04A3C-5712-483F-8938-F694554A2DFB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SATIS_ANALIZ_CARI_PER"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}"
          SQLTask:SqlStatementSource=" INSERT INTO SATIS_ANALIZ_CARI_PER  &#xA;SELECT &#xA;[cari_temsilci_kodu],&#xA; Musteri_Temsilcisi ,&#xA;cari_temsilci_kodu+' - '+ Musteri_Temsilcisi  as Temsilci_Kodu_Adi&#xA;FROM &#xA;(&#xA;SELECT &#xA; (CASE WHEN [cari_per_kod]='P005' THEN 'P006'ELSE [cari_per_kod] END)  AS [cari_temsilci_kodu]&#xA;&#x9;  &#x9;  ,(CASE WHEN [cari_per_adi]='M.LAFCI' THEN 'İSTOÇ ŞUBE' WHEN [cari_per_soyadi] ='' THEN [cari_per_adi]   ELSE [cari_per_adi]+' '+[cari_per_soyadi] END) AS Musteri_Temsilcisi&#xA;      &#xA;  FROM [CARI_PERSONEL_TANIMLARI] CPT&#xA;  INNER JOIN CARI_HESAPLAR CHS ON cari_temsilci_kodu=CPT.cari_per_kod) T&#xA;  WHERE cari_temsilci_kodu between 'P001' AND 'P017'&#xA;&#xA;  GROUP BY cari_temsilci_kodu, Musteri_Temsilcisi" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SATIS_ANALIZ_CHA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{87E5FD27-305F-45A2-BAFD-BD91110DF8A1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SATIS_ANALIZ_CHA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}"
          SQLTask:SqlStatementSource="INSERT INTO SATIS_ANALIZ_CHA&#xA;SELECT &#xA; [cha_Guid]&#xA;,[cha_evrak_tip]&#xA;,[cha_tarihi]&#xA;,[cha_kod]&#xA;,[cari_unvan1]&#xA;,[cha_tip]&#xA;,[cha_normal_Iade]&#xA;,[cha_tpoz]&#xA;,[cha_miktari]&#xA;,[cha_meblag]&#xA;,cha_d_cins&#xA;,cha_evrakno_seri&#xA;,cha_evrakno_sira&#xA;,cha_belge_no&#xA;,[cha_vergi]&#xA;,cha_d_kur&#xA;,[cha_altd_kur]&#xA;,[cari_temsilci_kodu]&#xA;,cha_satici_kodu&#xA;,KUR&#xA;,KONTROL&#xA;,(CASE WHEN cha_evrak_tip=0 THEN eksi_yerel_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63) THEN arti_yerel_meblag ELSE NULL END) AS Yerel_Meblag&#xA;,(CASE WHEN (cha_evrak_tip=0 and cha_tpoz=0) THEN eksi_usd_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63)  OR(cha_evrak_tip=0 and cha_normal_Iade=1 and cha_tpoz=1) THEN arti_usd_meblag ELSE NULL END) AS Usd_Meblag&#xA;,(CASE WHEN KUR=0 THEN 0 ELSE (&#xA;(CASE WHEN cha_evrak_tip=0 THEN eksi_yerel_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63) THEN arti_yerel_meblag ELSE NULL END)&#xA;/KUR) END) AS Meblag_Kur&#xA;,(CASE WHEN ((cha_evrak_tip IN (1,2,4,34) or  ( cha_evrak_tip=33 and cha_belge_no like ('%TAH%'))) OR  (cha_evrak_tip=57 AND (cha_evrakno_seri='B2B' OR cha_evrakno_seri='İK'))) and cha_tip=1 &#xA;THEN SUM((CASE WHEN cha_evrak_tip=0 THEN eksi_yerel_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63) THEN arti_yerel_meblag ELSE NULL END)) END)AS Tutar_Tahsilat_&#xA;,(CASE WHEN ((cha_evrak_tip IN (1,2,4,34) or  ( cha_evrak_tip=33 and cha_belge_no like ('%TAH%'))) OR  (cha_evrak_tip=57 AND (cha_evrakno_seri='B2B' OR cha_evrakno_seri='İK'))) and cha_tip=1 &#xA;THEN SUM((CASE WHEN (cha_evrak_tip=0 and cha_tpoz=0) THEN eksi_usd_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63)  OR(cha_evrak_tip=0 and cha_normal_Iade=1 and cha_tpoz=1) THEN arti_usd_meblag ELSE NULL END)) END)AS Tutar_Tahsilat_usd&#xA;,dbo.fn_OpVadeTarih(cha_vade,cha_tarihi) cha_vade_tarihi&#xA;FROM&#xA; (&#xA; SELECT * &#xA;          ,(CASE WHEN cha_d_cins=1 THEN (([cha_meblag]-[cha_vergi])*(-1)*KUR) WHEN cha_d_cins IN (0) THEN (([cha_meblag]-[cha_vergi])*(-1)) ELSE NULL END) AS eksi_yerel_meblag &#xA;          ,(CASE WHEN cha_d_cins=1 THEN (([cha_meblag]-[cha_vergi])*KUR) WHEN cha_d_cins IN (0) THEN (([cha_meblag]-[cha_vergi]))ELSE NULL END) AS arti_yerel_meblag &#xA;&#x9;&#x9;  ,(CASE WHEN cha_d_cins=0 THEN (([cha_meblag])*(-1)*cha_d_kur/[cha_altd_kur]) WHEN cha_d_cins IN (1) THEN (([cha_meblag])*(-1)) ELSE NULL END) AS eksi_usd_meblag&#xA;&#x9;      ,(CASE WHEN cha_d_cins=0 THEN (([cha_meblag])*cha_d_kur/[cha_altd_kur])WHEN cha_d_cins IN (1) THEN (([cha_meblag]))ELSE NULL END) AS arti_usd_meblag&#xA; FROM &#xA;&#xA;   (SELECT &#xA;             [cha_Guid]&#xA;            ,[cha_evrak_tip]&#xA;            ,[cha_tarihi]&#xA;            ,(case when [cha_ciro_cari_kodu]!='' then cha_ciro_cari_kodu else [cha_kod] end) as [cha_kod]&#xA;            ,[cari_unvan1]&#xA;            ,[cha_tip]&#xA;            ,[cha_normal_Iade]&#xA;            ,[cha_tpoz]&#xA;            ,[cha_miktari]&#xA;            ,[cha_meblag]&#xA;            ,cha_d_cins &#xA;&#x9;&#x9;&#x9;,cha_evrakno_seri&#xA;&#x9;&#x9;&#x9;,cha_evrakno_sira&#xA;&#x9;&#x9;&#x9;,cha_belge_no&#xA;&#x9;&#x9;&#x9;,(ISNULL(cha_vergi1,0)+ISNULL(cha_vergi2,0)+ISNULL(cha_vergi3,0)+ISNULL(cha_vergi4,0)+ISNULL(cha_vergi5,0)+ISNULL(cha_vergi6,0)+ISNULL(cha_vergi7,0)+ISNULL(cha_vergi8,0)+ISNULL(cha_vergi9,0)+ISNULL(cha_vergi10,0)+ISNULL(cha_vergi11,0)+ISNULL(cha_vergi12,0)+ISNULL(cha_vergi13,0)+ISNULL(cha_vergi14,0)+ISNULL(cha_vergi15,0)+ISNULL(cha_vergi16,0)+ISNULL(cha_vergi17,0)+ISNULL(cha_vergi18,0)+ISNULL(cha_vergi19,0)+ISNULL(cha_vergi20,0)) as cha_vergi&#xA;&#x9;&#x9;&#x9;,cha_d_kur&#xA;            ,[cha_altd_kur]&#xA;            ,(CASE WHEN[cari_temsilci_kodu]='P005' THEN 'P006'  &#xA;&#x9;&#x9;&#x9; WHEN[cari_temsilci_kodu]='P001' THEN 'P006'   &#xA;&#x9;&#x9;&#x9; --WHEN[cari_temsilci_kodu]='PD055' THEN 'P006'   &#xA;&#x9;&#x9;&#x9; ELSE cari_temsilci_kodu END) as cari_temsilci_kodu&#xA;&#x9;&#x9;&#x9;             ,(CASE WHEN[cari_temsilci_kodu]='P005' THEN 'P006'  &#xA;&#x9;&#x9;&#x9; WHEN cha_satici_kodu='P001' THEN 'P006'   &#xA;&#x9;&#x9;&#x9; --WHEN[cari_temsilci_kodu]='PD055' THEN 'P006'   &#xA;&#x9;&#x9;&#x9; ELSE cha_satici_kodu END) as cha_satici_kodu&#xA;&#xA;            ,(select top 1 dov_fiyat1 from DOVIZ_KURLARI where dov_no=1 and dov_tarih&lt;=cha_tarihi order by dov_tarih desc) AS KUR&#xA;            ,(CASE WHEN cha_evrak_tip=0 AND cha_normal_Iade=0 THEN 1 ELSE 0 END) AS KONTROL&#xA;&#x9;&#x9;&#x9;,cha_vade,&#xA;&#x9;&#x9;&#x9;CASE WHEN cha_cinsi IN (1,2,3,4) THEN (select top 1 Y.cha_sntck_poz from CARI_HESAP_HAREKETLERI  AS Y WITH (NOLOCK) where CHS.cha_trefno=Y.cha_trefno AND Y.cha_kod=CHS.cha_kod order by Y.cha_tarihi desc,cha_lastup_date DESC) ELSE 0 END AS [SNTCEK_POZ] -- ÇEKİN SON DURUMU&#xA;   FROM  CARI_HESAP_HAREKETLERI CHS WITH(NOLOCK)&#xA;   INNER JOIN  CARI_HESAPLAR CH WITH(NOLOCK) ON CH.cari_kod=IIF(cha_ciro_cari_kodu='',cha_kod,cha_ciro_cari_kodu)&#xA;   WHERE cha_tarihi&gt;='2020-01-01' and  ([cari_temsilci_kodu] BETWEEN 'P001' AND 'P017')&#xA;    ) T&#xA;&#x9;WHERE [SNTCEK_POZ] NOT IN (4,7) -- SON DURUMU İADE EDİLMİŞ OLAN ÇEKLER GELMESİN.&#xA; )T2 &#xA; group by&#xA;cha_Guid      ,[cha_evrak_tip]      ,[cha_tarihi],[cha_vade]      ,[cha_kod]&#x9;  ,[cari_unvan1]      ,[cha_tip]      ,[cha_normal_Iade]      ,[cha_tpoz],  [cha_evrakno_seri]  ,[cha_evrakno_sira],[cha_belge_no]&#xA;      ,[cha_miktari]      ,[cha_meblag]      , cha_d_cins       ,[cha_vergi]      ,[cha_altd_kur]      ,[cari_temsilci_kodu],cha_satici_kodu   , KONTROL ,cha_d_kur,KUR,&#xA;&#x9;  (CASE WHEN cha_evrak_tip=0 THEN eksi_yerel_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63) THEN arti_yerel_meblag ELSE NULL END) ,&#xA;(CASE WHEN (cha_evrak_tip=0 and cha_tpoz=0) THEN eksi_usd_meblag WHEN cha_evrak_tip IN (1,2,4,29,31,33,34,57,63)  OR(cha_evrak_tip=0 and cha_normal_Iade=1 and cha_tpoz=1) THEN arti_usd_meblag ELSE NULL END)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SATIS_ANALIZ_STH"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{091DDE3A-E7F7-4574-9635-98A6B4C27B1E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SATIS_ANALIZ_STH"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}"
          SQLTask:SqlStatementSource="INSERT INTO SATIS_ANALIZ_STH&#xA;SELECT&#xA;C.cha_tarihi&#xA;,[sth_tarih]&#xA;,[sth_tip]&#xA;,[sth_evraktip]&#xA;,[sth_fat_uid]&#xA;,[sth_normal_iade]&#xA;,sth_stok_kod&#xA;,sth_har_doviz_cinsi&#xA;,sth_har_doviz_kuru&#xA;,sth_alt_doviz_kuru&#xA;,[sth_miktar]&#xA;,(CASE WHEN sth_tip=0 THEN sth_miktar WHEN sth_tip=1 THEN sth_miktar*(-1) END) AS Miktar1&#xA;,IIF(sth_tip=0,sth_giris_depo_no,sth_cikis_depo_no) AS Depo &#xA;,[sth_tutar]&#xA;,(CASE WHEN [sth_evraktip] IN(3,13) AND [sth_normal_iade]=0 THEN 1 ELSE 0 END) AS KONTROL&#xA;,[sth_iskonto1]+[sth_iskonto2]+[sth_iskonto3]+[sth_iskonto4]+[sth_iskonto5]+[sth_iskonto6] AS TOPLAM_ISKONTO&#xA;,sth_plasiyer_kodu&#xA;,sth_alt_doviz_kuru as Kur&#xA;,&#xA;CASE WHEN sth_har_doviz_cinsi=2 THEN sth_har_doviz_kuru &#xA;ELSE (SELECT top 1 dov_fiyat1 FROM [dbo].[DOVIZ_KURLARI] where dov_no=2 and dov_tarih &lt;= C.cha_tarihi order by dov_tarih desc) END as Kur_e&#xA;,(SELECT top 1 dov_fiyat1 FROM [dbo].[DOVIZ_KURLARI] where dov_no=1 and dov_tarih &lt;= C.cha_tarihi order by dov_tarih desc) *sth_maliyet_alternatif AS sth_maliyet_ana_kur&#xA;,(CASE WHEN sth_tip=0 THEN sth_maliyet_ana WHEN sth_tip=1 THEN sth_maliyet_ana*(-1) END) AS maliyet_ana&#xA;,(CASE WHEN sth_tip=0 THEN sth_maliyet_alternatif WHEN sth_tip=1 THEN sth_maliyet_alternatif*(-1) END) AS maliyet_alternatif&#xA;--,sth_vergi&#xA;&#xA;FROM [STOK_HAREKETLERI] S&#xA;LEFT JOIN CARI_HESAP_HAREKETLERI C ON cha_Guid = sth_fat_uid&#xA;WHERE S.sth_evraktip NOT IN (0,2,6,10,11,12,15,17) and sth_fat_uid &lt;&gt; '00000000-0000-0000-0000-000000000000'&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SATIS_HEDEFLERI"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2FE87EC6-B5B3-46DF-B9E3-3A22AEE77BBF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SATIS_HEDEFLERI"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}"
          SQLTask:SqlStatementSource="INSERT INTO SATIS_HEDEFLERI &#xA;SELECT TEMP.* FROM&#xA;&#xA;(SELECT &#xA;&#x9;[fldSatisModelCode]AS mdl_kodu, &#xA;&#x9;[fldCariTemsilciCode] AS cari_per_kodu, &#xA;    [fldYil] AS Year,&#xA;    SUBSTRING(AY_adi,4,LEN(AY_adi)) AS AY_adi,&#xA;&#x9; fldCariTemsilciCode + '-'+ fldSatisModelCode as 'Key',&#xA;&#x9;TUTAR&#xA;&#xA;  FROM [192.168.1.68].[Report_DB_AKBEL].[dbo].[tblSatisHedefleri] ST&#xA;  &#xA;  UNPIVOT&#xA;  (TUTAR FOR AY_adi IN([fldOcak], [fldSubat], [fldMart], [fldNisan], [fldMayis], [fldHaziran], [fldTemmuz], [fldAgustos], [fldEylul], [fldEkim], [fldKasim], [fldAralik])) AS UNPVT&#xA;&#xA;&#xA; ) AS TEMP&#xA;   INNER JOIN [192.168.1.68].[Report_DB_AKBEL].[dbo].[CARI_PERSONEL_TANIMLARI] R ON R.[cari_per_kod] COLLATE Turkish_CS_AS= TEMP.cari_per_kodu  &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
