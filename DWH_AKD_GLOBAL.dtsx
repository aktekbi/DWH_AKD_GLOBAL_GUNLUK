          SQLTask:SqlStatementSource="INSERT INTO   STOK_HAREKETLERI_DEPO&#xA; SELECT ROW_NUMBER() OVER ( ORDER BY T.sth_tarih) as ID,T.sth_tarih,T.sth_stok_kod,T.Miktar1,T.maliyet_alternatif,T.maliyet_ana,T.Depo,T.sth_evraktip,&#xA;--TL İÇİN &#xA;CASE &#xA;WHEN T.stkfdov IS NOT NULL  AND T.stkfdov= 1 THEN T.stkffiyat*T.sth_alt_doviz_kuru&#xA;WHEN T.stkfdov IS NOT NULL  AND T.stkfdov= 2 THEN T.stkffiyat*T.Kur_e&#xA;WHEN T.stkfdov IS NOT NULL  AND T.stkfdov= 0 THEN T.stkffiyat&#xA;ELSE &#xA;&#x9;CASE &#xA;&#x9;WHEN T.aktfyt IS NOT NULL THEN T.aktfyt*T.sth_alt_doviz_kuru&#xA;&#x9;ELSE T.maliyet_ana&#xA;&#x9;END&#xA;END AS maliyet_tl,&#xA;--USD İÇİN &#xA;CASE &#xA;WHEN T.stkfdov IS NOT NULL AND T.stkfdov= 0 THEN T.stkffiyat/T.sth_alt_doviz_kuru&#xA;WHEN T.stkfdov IS NOT NULL AND T.stkfdov= 2 THEN T.stkffiyat*(T.Kur_e/T.sth_alt_doviz_kuru)&#xA;WHEN T.stkfdov IS NOT NULL AND T.stkfdov= 1 THEN T.stkffiyat&#xA;ELSE &#xA;&#x9;CASE &#xA;&#x9;WHEN T.aktfyt IS NOT NULL THEN T.aktfyt&#xA;&#x9;ELSE T.maliyet_alternatif&#xA;&#x9;END&#xA;END AS maliyet_usd&#xA;FROM (&#xA;SELECT&#xA; SH.sth_tarih&#xA;,SH.sth_stok_kod&#xA;,SH.sth_evraktip&#xA;,SH.sth_alt_doviz_kuru&#xA;,(SELECT top 1 dov_fiyat1 FROM [DOVIZ_KURLARI] where dov_no=2 and dov_tarih &lt;= SH.sth_tarih order by dov_tarih desc) as Kur_e&#xA;,(CASE WHEN SH.sth_tip=0 THEN SH.sth_miktar WHEN SH.sth_tip=1 THEN SH.sth_miktar*(-1) END) AS Miktar1&#xA;,(CASE WHEN SH.sth_tip=0 THEN SH.sth_maliyet_alternatif WHEN SH.sth_tip=1 THEN SH.sth_maliyet_alternatif*(-1) END) AS maliyet_alternatif&#xA;,(CASE WHEN SH.sth_tip=0 THEN SH.sth_maliyet_ana WHEN SH.sth_tip=1 THEN SH.sth_maliyet_ana*(-1) END) AS maliyet_ana&#xA;,CASE WHEN SH.sth_tip=0 THEN SH.sth_giris_depo_no ELSE SH.sth_cikis_depo_no END AS Depo&#xA;,CASE WHEN SH.sth_tip=0 THEN (SELECT TOP 1 stkf_fiyat FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=SH.sth_stok_kod and  SH.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC)*SH.sth_miktar&#xA;&#x9;WHEN SH.sth_tip=1  THEN (SELECT TOP 1 stkf_fiyat FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=SH.sth_stok_kod and   SH.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC)*(-1)*SH.sth_miktar END AS stkffiyat&#xA;,(SELECT TOP 1 stkf_fiyat_doviz FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=sth_stok_kod and   SH.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC ) stkfdov&#xA;,CASE WHEN SH.sth_tip=0 THEN (SELECT ROUND(AVG(fid_yenifiy_tutar),2) as fid_yenifiy_tutar &#xA;FROM&#xA;(SELECT TOP 3 fid_yenifiy_tutar &#xA;FROM DWH_AKTRADE.dbo.STOK_FIYAT_DEGISIKLIKLERI SF&#xA;INNER JOIN DWH_AKTRADE.dbo.STOK_HAREKETLERI SH ON SF.fid_stok_kod = SH.sth_stok_kod &#xA;AND (SH.sth_evraktip = 4 AND SH.sth_normal_iade=0) AND SH.sth_cari_kodu = 'T322U2'&#xA;WHERE fid_stok_kod=SH.sth_stok_kod and  SF.fid_tarih &lt;= SH.sth_tarih ORDER BY SF.fid_tarih DESC) T)*SH.sth_miktar&#xA;&#x9;  WHEN SH.sth_tip=1  THEN (SELECT ROUND(AVG(fid_yenifiy_tutar),2) as fid_yenifiy_tutar &#xA;FROM&#xA;(SELECT TOP 3 fid_yenifiy_tutar &#xA;FROM DWH_AKTRADE.dbo.STOK_FIYAT_DEGISIKLIKLERI SF&#xA;INNER JOIN DWH_AKTRADE.dbo.STOK_HAREKETLERI SH ON SF.fid_stok_kod = SH.sth_stok_kod &#xA;AND (SH.sth_evraktip = 4 AND SH.sth_normal_iade=0) AND SH.sth_cari_kodu = 'T322U2'&#xA;WHERE fid_stok_kod=SH.sth_stok_kod and  SF.fid_tarih &lt;= SH.sth_tarih ORDER BY SF.fid_tarih DESC) T)*(-1)*SH.sth_miktar END AS aktfyt&#xA;&#xA;FROM [STOK_HAREKETLERI] SH&#xA;&#xA;WHERE SH.sth_tip!=2&#xA;&#xA;UNION ALL &#xA;&#xA;SELECT&#xA; S1.sth_tarih&#xA;,S1.sth_stok_kod&#xA;,S1.sth_evraktip&#xA;,S1.sth_alt_doviz_kuru&#xA;,(SELECT top 1 dov_fiyat1 FROM [DOVIZ_KURLARI] where dov_no=2 and dov_tarih &lt;= S1.sth_tarih order by dov_tarih desc) as Kur_e&#xA;,S1.sth_miktar*-1 AS Miktar1&#xA;,S1.sth_maliyet_alternatif*-1 AS maliyet_alternatif&#xA;,S1.sth_maliyet_ana*-1 AS maliyet_ana&#xA;,S1.sth_cikis_depo_no AS Depo &#xA;,(SELECT TOP 1 stkf_fiyat FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=S1.sth_stok_kod and S1.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC )*-1*S1.sth_miktar stkffiyat&#xA;,(SELECT TOP 1 stkf_fiyat_doviz FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=S1.sth_stok_kod and  S1.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC ) stkfdov&#xA;,(SELECT ROUND(AVG(fid_yenifiy_tutar),2) as fid_yenifiy_tutar &#xA;FROM&#xA;(SELECT TOP 3 fid_yenifiy_tutar &#xA;FROM DWH_AKTRADE.dbo.STOK_FIYAT_DEGISIKLIKLERI SF&#xA;INNER JOIN DWH_AKTRADE.dbo.STOK_HAREKETLERI SH ON SF.fid_stok_kod = SH.sth_stok_kod &#xA;AND (SH.sth_evraktip = 4 AND SH.sth_normal_iade=0) AND SH.sth_cari_kodu = 'T322U2'&#xA;WHERE fid_stok_kod=S1.sth_stok_kod and  SF.fid_tarih &lt;= S1.sth_tarih ORDER BY SF.fid_tarih DESC) T)*-1*S1.sth_miktar aktfyt&#xA;&#xA;FROM [STOK_HAREKETLERI] S1  WHERE S1.sth_tip=2&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT&#xA; S2.sth_tarih&#xA;,S2.sth_stok_kod&#xA;,S2.sth_evraktip&#xA;,S2.sth_alt_doviz_kuru&#xA;,(SELECT top 1 dov_fiyat1 FROM [DOVIZ_KURLARI] where dov_no=2 and dov_tarih &lt;= S2.sth_tarih order by dov_tarih desc) as Kur_e&#xA;,S2.sth_miktar*1 AS Miktar1&#xA;,S2.sth_maliyet_alternatif*1 AS maliyet_alternatif&#xA;,S2.sth_maliyet_ana*1 AS maliyet_ana&#xA;,S2.sth_giris_depo_no*1 AS Depo &#xA;,(SELECT TOP 1 stkf_fiyat FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=S2.sth_stok_kod and  S2.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC)*S2.sth_miktar stkffiyat&#xA;,(SELECT TOP 1 stkf_fiyat_doviz FROM BI_STOK_ALTERNATIF_FIYAT WHERE stkf_sto_kod=S2.sth_stok_kod and  S2.sth_tarih between stkf_bas_tarih and stkf_bit_tarih ORDER BY stkf_bit_tarih DESC ) stkfdov&#xA;,(SELECT ROUND(AVG(fid_yenifiy_tutar),2) as fid_yenifiy_tutar &#xA;FROM&#xA;(SELECT TOP 3 fid_yenifiy_tutar &#xA;FROM DWH_AKTRADE.dbo.STOK_FIYAT_DEGISIKLIKLERI SF&#xA;INNER JOIN DWH_AKTRADE.dbo.STOK_HAREKETLERI SH ON SF.fid_stok_kod = SH.sth_stok_kod &#xA;AND (SH.sth_evraktip = 4 AND SH.sth_normal_iade=0) AND SH.sth_cari_kodu = 'T322U2'&#xA;WHERE fid_stok_kod=S2.sth_stok_kod and  SF.fid_tarih &lt;= S2.sth_tarih ORDER BY SF.fid_tarih DESC) T)*S2.sth_miktar aktfyt&#xA;&#xA;&#xA;FROM [STOK_HAREKETLERI] S2 WHERE S2.sth_tip=2)T &#xA;&#xA;LEFT JOIN STOKLAR ST ON ST.sto_kod=T.sth_stok_kod &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
