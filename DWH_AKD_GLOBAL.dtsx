        <SQLTask:SqlTaskData
          SQLTask:Connection="{0534B50F-75F8-43B9-9E9C-6447C73E3E69}"
          SQLTask:SqlStatementSource="USE DWH_AKD_GLOBAL&#xA;GO&#xA;TRUNCATE TABLE SATIS_HEDEFLERI&#xA;TRUNCATE TABLE SATIS_ANALIZ_CHA &#xA;TRUNCATE TABLE SATIS_ANALIZ_STH&#xA;TRUNCATE TABLE SATIS_ANALIZ_CARI_PER&#xA;TRUNCATE TABLE STOK_MODEL_TANIMLARI&#xA;TRUNCATE TABLE CARI_PERSONEL_TANIMLARI&#xA;TRUNCATE TABLE DEPOLAR&#xA;TRUNCATE TABLE STOK_ALT_GRUPLARI&#xA;TRUNCATE TABLE STOK_ANA_GRUPLARI&#xA;TRUNCATE TABLE STOK_YILSEZON_TANIMLARI&#xA;TRUNCATE TABLE STOK_KATEGORILERI&#xA;TRUNCATE TABLE STOK_MARKALARI&#xA;TRUNCATE TABLE KUR_ISIMLERI&#xA;TRUNCATE TABLE MASRAF_HESAPLARI&#xA;TRUNCATE TABLE STOK_SEKTORLERI&#xA;TRUNCATE TABLE KASALAR&#xA;TRUNCATE TABLE STOK_FIYAT_DEGISIKLIKLERI&#xA;TRUNCATE TABLE STOK_SATIS_FIYAT_LISTE_TANIMLARI&#xA;TRUNCATE TABLE CARI_HESAP_TEMINATLARI&#xA;TRUNCATE TABLE VERI_TABANI_PARAMETRELERI&#xA;TRUNCATE TABLE  vw_Cari_Hareket_Evrak_Isimleri &#xA;TRUNCATE TABLE  BANKALAR&#xA;TRUNCATE TABLE  HIZMET_HESAPLARI&#xA;TRUNCATE TABLE  MUHASEBE_HESAP_PLANI&#xA;TRUNCATE TABLE  PERSONELLER&#xA;TRUNCATE TABLE  DEMIRBASLAR&#xA;TRUNCATE TABLE  ITHALAT_DOSYALARI&#xA;TRUNCATE TABLE  FINANSAL_SOZLESMELER&#xA;TRUNCATE TABLE  KREDI_SOZLESMESI_TANIMLARI&#xA;TRUNCATE TABLE  DONEMLERE_YAYILAN_HIZMETLER&#xA;TRUNCATE TABLE FIRMA_KREDI_KARTI_TANIMLARI&#xA;TRUNCATE TABLE vw_Gendata&#xA;TRUNCATE TABLE KONSINYE_HAREKETLERI&#xA;TRUNCATE TABLE ODEME_PLANLARI&#xA;TRUNCATE TABLE GUIDSTO&#xA;TRUNCATE TABLE GUIDSTH&#xA;TRUNCATE TABLE GUIDCAR&#xA;TRUNCATE TABLE GUIDCHA&#xA;TRUNCATE TABLE GUIDPRO&#xA;TRUNCATE TABLE GUIDSIP&#xA;TRUNCATE TABLE GUIDDOV&#xA;TRUNCATE TABLE GUIDSHO&#xA;TRUNCATE TABLE GUIDCHI&#xA;TRUNCATE TABLE CARI_HESAP_BOLGELERI&#xA;TRUNCATE TABLE CARI_HESAP_ADRESLERI&#xA;TRUNCATE TABLE CARI_HESAP_GRUPLARI&#xA;TRUNCATE TABLE DOVIZ_KURLARI&#xA;TRUNCATE TABLE CARI_ESLEME&#xA;TRUNCATE  TABLE MUHASEBE_FISLERI&#xA;TRUNCATE TABLE tblTakip&#xA;TRUNCATE TABLE tblSubeler&#xA;TRUNCATE TABLE tblDosyalar&#xA;TRUNCATE TABLE tblSiparisDosyalar&#xA;TRUNCATE TABLE tblSiparisler&#xA;TRUNCATE TABLE CARI_HESAPLAR_USER&#xA;TRUNCATE TABLE BI_STOK_ALTERNATIF_FIYAT&#xA;TRUNCATE TABLE STOK_HAREKETLERI_DEPO&#xA;TRUNCATE TABLE tblSatisHedefleri&#xA;TRUNCATE TABLE CARI_HESAP_HAREKETLERI_OZET&#xA;TRUNCATE TABLE STOKLAR_USER" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
