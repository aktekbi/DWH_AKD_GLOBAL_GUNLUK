                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [cari_a_bakiye_degerlendirilmesin_fl], [cari_a_irsbakiye_degerlendirilmesin_fl], [cari_a_sipbakiye_degerlendirilmesin_fl], [cari_AlinanDepozitoTeminatMuhKodu], [cari_AlinanDepozitoTeminatMuhKodu1], [cari_AlinanDepozitoTeminatMuhKodu2], [cari_Ana_cari_kodu], [cari_b_bakiye_degerlendirilmesin_fl], [cari_b_irsbakiye_degerlendirilmesin_fl], [cari_b_sipbakiye_degerlendirilmesin_fl], [cari_baba_adi], [cari_baglanti_tipi], [cari_BagliOrtaklisa_Firma], [cari_banka_hesapno1], [cari_banka_hesapno10], [cari_banka_hesapno2], [cari_banka_hesapno3], [cari_banka_hesapno4], [cari_banka_hesapno5], [cari_banka_hesapno6], [cari_banka_hesapno7], [cari_banka_hesapno8], [cari_banka_hesapno9], [cari_banka_swiftkodu1], [cari_banka_swiftkodu10], [cari_banka_swiftkodu2], [cari_banka_swiftkodu3], [cari_banka_swiftkodu4], [cari_banka_swiftkodu5], [cari_banka_swiftkodu6], [cari_banka_swiftkodu7], [cari_banka_swiftkodu8], [cari_banka_swiftkodu9], [cari_banka_tcmb_ilkod1], [cari_banka_tcmb_ilkod10], [cari_banka_tcmb_ilkod2], [cari_banka_tcmb_ilkod3], [cari_banka_tcmb_ilkod4], [cari_banka_tcmb_ilkod5], [cari_banka_tcmb_ilkod6], [cari_banka_tcmb_ilkod7], [cari_banka_tcmb_ilkod8], [cari_banka_tcmb_ilkod9], [cari_banka_tcmb_kod1], [cari_banka_tcmb_kod10], [cari_banka_tcmb_kod2], [cari_banka_tcmb_kod3], [cari_banka_tcmb_kod4], [cari_banka_tcmb_kod5], [cari_banka_tcmb_kod6], [cari_banka_tcmb_kod7], [cari_banka_tcmb_kod8], [cari_banka_tcmb_kod9], [cari_banka_tcmb_subekod1], [cari_banka_tcmb_subekod10], [cari_banka_tcmb_subekod2], [cari_banka_tcmb_subekod3], [cari_banka_tcmb_subekod4], [cari_banka_tcmb_subekod5], [cari_banka_tcmb_subekod6], [cari_banka_tcmb_subekod7], [cari_banka_tcmb_subekod8], [cari_banka_tcmb_subekod9], [cari_bolge_kodu], [cari_BUV_tabi_fl], [cari_cari_kilitli_flg], [cari_cariodemetercihi], [cari_CepTel], [cari_checksum], [cari_create_date], [cari_create_user], [cari_CRM_sistemine_aktar_fl], [cari_DBCno], [cari_def_efatura_cinsi], [cari_def_eirsaliye_cinsi], [cari_degisti], [cari_Detay_incele_flg], [cari_doviz_cinsi], [cari_doviz_cinsi1], [cari_doviz_cinsi2], [cari_earsiv_xslt_dosya], [cari_efatura_baslangic_tarihi], [cari_efatura_fl], [cari_efatura_xslt_dosya], [cari_EftHesapNum], [cari_eirsaliye_baslangic_tarihi], [cari_eirsaliye_fl], [cari_eirsaliye_xslt_dosya], [cari_EMail], [cari_etiket_bas_fl], [cari_faal_terk], [cari_fatura_adres_no], [cari_fileid], [cari_firma_acik_kapal], [cari_gonderionayi_email], [cari_gonderionayi_sms], [cari_grup_kodu], [cari_Guid], [cari_hal_caritip], [cari_HalKomYuzdesi], [cari_hareket_tipi], [cari_hidden], [cari_iptal], [cari_istasyon_cari_kodu], [cari_KabEdFCekTutar], [cari_kampanyakodu], [cari_kamu_kurumu_fl], [cari_kaydagiristarihi], [cari_KEP_adresi], [cari_kilitli], [cari_kisi_kimlik_bilgisi_aciklama_turu], [cari_kisi_kimlik_bilgisi_diger_aciklama], [cari_kod], [cari_KrediRiskTakibiVar_flg], [cari_KurHesapSekli], [cari_lastup_date], [cari_lastup_user], [cari_mersis_no], [cari_muh_kod], [cari_muh_kod1], [cari_muh_kod2], [cari_muhartikeli], [cari_mutabakat_mail_adresi], [cari_nacekodu_1], [cari_nacekodu_2], [cari_nacekodu_3], [cari_nakakincelenmesi], [cari_odeme_cinsi], [cari_odeme_gunu], [cari_odeme_sekli], [cari_odemeplan_no], [cari_opsiyon_gun], [cari_otv_tevkifatina_tabii_fl], [cari_ozel_butceli_kurum_carisi], [cari_pasaport_no], [cari_Perakende_fl], [cari_Portal_Enabled], [cari_Portal_PW], [cari_POS_ongIskOran], [cari_POS_ongpesyuzde], [cari_POS_ongtaksayi], [cari_satis_fk], [cari_satis_isk_kod], [cari_sektor_kodu], [cari_sevk_adres_no], [cari_sicil_no], [cari_sirket_turu], [cari_special1], [cari_special2], [cari_special3], [cari_SpecRECno], [cari_stok_alim_cinsi], [cari_stok_satim_cinsi], [cari_tasiyicifirma_cari_kodu], [cari_TeminatMekAlacakMuhKodu], [cari_TeminatMekAlacakMuhKodu1], [cari_TeminatMekAlacakMuhKodu2], [cari_TeminatMekBorcMuhKodu], [cari_TeminatMekBorcMuhKodu1], [cari_TeminatMekBorcMuhKodu2], [cari_temsilci_kodu], [cari_TeslimSuresi], [cari_ufrs_fark_muh_kod], [cari_ufrs_fark_muh_kod1], [cari_ufrs_fark_muh_kod2], [cari_unvan1], [cari_unvan2], [cari_uts_kurum_no], [cari_vade_fark_yuz], [cari_vade_fark_yuz1], [cari_vade_fark_yuz2], [cari_VarsayilanCikisDepo], [cari_VarsayilanGirisDepo], [cari_vdaire_adi], [cari_vdaire_no], [cari_vergidairekodu], [cari_VergiKimlikNo], [cari_vergimukellefidegil_mi], [cari_VerilenDepozitoTeminatMuhKodu], [cari_VerilenDepozitoTeminatMuhKodu1], [cari_VerilenDepozitoTeminatMuhKodu2], [cari_wwwadresi], [cari_yeni_dogan_mi] FROM [dbo].[CARI_HESAPLAR]</property>
